# Copiez ce fichier en .env.local puis renseignez les valeurs réelles.
# Aucune valeur ici n'est une vraie clé — ce fichier ne contient que la liste des variables nécessaires.

# ── Appwrite (instance self-hosted 1.7.4) ──────────────────────────────────────
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
APPWRITE_DB_ID=

# ── Appwrite — collections (créées dans la base ci-dessus) ─────────────────────
APPWRITE_COLLECTION_USERS=
APPWRITE_COLLECTION_JOBS=
APPWRITE_COLLECTION_APPLICATIONS=
APPWRITE_COLLECTION_INTERVIEWS=
APPWRITE_COLLECTION_TENANTS=
APPWRITE_COLLECTION_AI_CONFIG=
APPWRITE_COLLECTION_TEMPLATES_CONFIG=
APPWRITE_COLLECTION_SITE_LAYOUT=
APPWRITE_COLLECTION_SCREENINGS=
APPWRITE_COLLECTION_LINKEDIN_JOBS=
APPWRITE_COLLECTION_LINKEDIN_CONFIG=
APPWRITE_COLLECTION_LINKEDIN_GROUP_QUEUE=
APPWRITE_COLLECTION_ANALYTICS_CONFIG=
APPWRITE_COLLECTION_VIVIER_CVS=
APPWRITE_COLLECTION_RECOMMENDATIONS=
APPWRITE_COLLECTION_FUNNEL_STAGES=
APPWRITE_COLLECTION_FUNNEL_EVENTS=
APPWRITE_COLLECTION_FUNNEL_PIPELINES=
APPWRITE_COLLECTION_JOB_MATCHES=
APPWRITE_COLLECTION_APPLICATION_EMAILS=
APPWRITE_COLLECTION_SUPPORT_TICKETS=
APPWRITE_COLLECTION_SUPPORT_MESSAGES=
APPWRITE_COLLECTION_SOCIAL_POSTS=
# AO Offers : appels d'offres reçus par e-mail (créées par npm run ao:setup -- .env.dev --apply).
APPWRITE_COLLECTION_AO_EMAILS=ao_emails
APPWRITE_COLLECTION_AO_OFFERS=ao_offers
APPWRITE_COLLECTION_AO_STATE=ao_sync_state
# Boîtes lues (plateforme et organisations), mots de passe chiffrés.
APPWRITE_COLLECTION_AO_SOURCES=ao_sources
# Détails des offres (assistance / forfait, technologies) : un document par offre, ao_offers étant plein.
APPWRITE_COLLECTION_AO_OFFER_DETAILS=ao_offer_details
# Commentaires internes sur les offres AO (facultatif : sans elle, seuls les commentaires sont indisponibles).
APPWRITE_COLLECTION_AO_COMMENTS=ao_comments
# Assistant IA des espaces candidat et recruteur : collection des conversations, créée par npm run assistant:setup.
# La purge des 30 jours (/api/cron/assistant-purge) et la suppression avec le compte en dépendent : ne pas la retirer
# tant que la collection contient des conversations. Vercel : portée Preview d'abord, Production seulement après
# « npm run assistant:setup -- <env> --prod --apply » ; en local, seulement dans un fichier qui vise bestconsultant-dev.
APPWRITE_COLLECTION_ASSISTANT_TURNS=assistant_turns
# « true » affiche l'assistant (adresse e-mail vérifiée exigée). Pour le masquer, retirer celle-ci, pas la précédente.
ASSISTANT_ENABLED=

# ── Appwrite — buckets de stockage ──────────────────────────────────────────────
APPWRITE_STORAGE_CVS=
APPWRITE_STORAGE_LOGOS=
APPWRITE_STORAGE_RECORDINGS=
APPWRITE_STORAGE_VIVIER_CVS=
APPWRITE_STORAGE_SUPPORT=

# ── Fournisseurs IA (au moins un requis ; le choix actif se règle dans /admin/llm-config) ──
# Les clés saisies dans /admin/llm-config sont prioritaires sur ces variables.
ANTHROPIC_API_KEY=
# Aussi le repli de la lecture des images / PDF scannés des AO quand Claude n'a plus de crédits (GPT-4o).
OPENAI_API_KEY=
TECKIA_API_KEY=
TECKIA_API_URL=
TECKIA_MODEL=

# ── Publication multi-réseaux (voir /admin/social) ──────────────────────────────
# Webhook Make.com qui orchestre la génération du visuel (kie.ai) et la publication (Buffer / natif).
MAKE_SOCIAL_WEBHOOK_URL=
# Mot de passe partagé entre la plateforme et le scénario Make (en-tête Authorization du webhook et du rappel).
SOCIAL_WEBHOOK_SECRET=
# Pilote Zernio (Instagram), en parallèle de Make + Buffer — voir /admin/social.
KIE_API_KEY=
ZERNIO_API_KEY=
ZERNIO_INSTAGRAM_ACCOUNT_ID=
# "off" coupe la génération de texte par IA pour les publications (tests/recette). Laisser vide en production.
SOCIAL_COPY_AI=
# "1" affiche les outils développeur de /admin/social en production (toujours affichés en local).
SOCIAL_DEV_TOOLS=

# ── Paiement (Stripe) — /abonnement ─────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secret du endpoint webhook Stripe (Dashboard Stripe › Developers › Webhooks).
STRIPE_WEBHOOK_SECRET=

# ── LinkedIn (sourcing) ──────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
APIFY_TOKEN=

# ── Divers ────────────────────────────────────────────────────────────────────
# URL publique du site (utilisée pour générer des liens absolus — emails, callbacks, réseaux sociaux).
NEXT_PUBLIC_APP_URL=
# Protège les routes /api/cron/* (32 caractères aléatoires ou plus ; refusé s'il fait moins de 16 caractères).
CRON_SECRET=
# Adresse d'envoi/réception du support (par défaut contact@tdidigital.io si absent).
SUPPORT_EMAIL=
# "off" coupe les emails de notification support (tests/recette).
SUPPORT_EMAILS=

# AO Offers — clé de chiffrement des mots de passe des boîtes IMAP (collection ao_sources). 32 octets en base64 :
# openssl rand -base64 32. Serveur seulement (jamais NEXT_PUBLIC_), la même sur le serveur et pour
# npm run ao:migrate-sources. La perdre ou la changer rend les mots de passe enregistrés illisibles : à ressaisir.
AO_CREDENTIALS_KEY=

# AO Offers — boîte de la plateforme (ao@wise-associates.fr). Lues UNIQUEMENT par npm run ao:migrate-sources, qui
# l'enregistre dans ao_sources (mot de passe chiffré) ; le serveur ne les lit plus (ADR 0005).
AO_IMAP_HOST=imap.ionos.fr
AO_IMAP_USER=ao@wise-associates.fr
# Mot de passe de la boîte (IONOS → Messagerie). Jamais dans le code ni dans git.
AO_IMAP_PASSWORD=
# Dossier lu (INBOX par défaut).
AO_IMAP_MAILBOX=INBOX
# Intervalle (minutes) de npm run ao:poll en local, 5 par défaut. Sur Vercel, l'intervalle est celui de vercel.json.
AO_POLL_INTERVAL_MINUTES=5

# Veilleur AO — copiez ce fichier en .env sur le serveur (chmod 600) puis renseignez les valeurs réelles.
# Aucune valeur ici n'est une vraie clé.

# Boîte surveillée : la même que celle lue par le site (mêmes valeurs que AO_IMAP_* sur Vercel).
AO_IMAP_HOST=imap.ionos.fr
AO_IMAP_PORT=993
AO_IMAP_USER=ao@wise-associates.fr
# Mot de passe de la boîte (IONOS → Messagerie).
AO_IMAP_PASSWORD=
# Dossier surveillé (INBOX par défaut).
AO_IMAP_MAILBOX=INBOX

# Adresse appelée à l'arrivée d'un message : l'adresse finale du site, sans redirection (https obligatoire ;
# mybestconsultant.fr redirige vers www, d'où le www).
AO_SYNC_URL=https://www.mybestconsultant.fr/api/cron/ao-inbox
# Exactement le CRON_SECRET de l'environnement Vercel visé (16 caractères minimum, sur une seule ligne).
CRON_SECRET=
# Contrôle de secours, même sans notification IMAP (minutes, 15 par défaut, de 1 à 1440).
AO_IDLE_FALLBACK_MINUTES=15
